# ==============================================================================
# SIH26091 - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholder values with your local settings.
# NEVER commit the actual .env file or hard-code credentials.
# ==============================================================================

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Database Configuration (PostgreSQL 15+ with psycopg3 driver)
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/goi_schemes
DATABASE_POOL_SIZE=10
DATABASE_SSL=false

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-in-production
REFRESH_TOKEN_EXPIRY_DAYS=30

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CORS_CREDENTIALS=true

# Anthropic Claude API Configuration (LLM Intelligence Engine)
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=2000
CLAUDE_TIMEOUT_SECONDS=30
CLAUDE_REQUEST_CACHE_TTL_HOURS=24

# Twilio Configuration (SMS OTP Authentication)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Redis Configuration (Caching & Rate Limiting)
REDIS_URL=redis://localhost:6379/0

# AWS/S3 Configuration (DPR & Report Storage)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=sih26091-reports
AWS_S3_URL_EXPIRY_HOURS=168

# Email Configuration (Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Toggles
FEATURE_CHAT_ENABLED=true
FEATURE_OFFLINE_MODE=true
FEATURE_SCHEME_VECTOR_SEARCH=true
FEATURE_PDF_GENERATION=true

# Monitoring / Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
