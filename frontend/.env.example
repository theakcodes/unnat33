# ==============================================================================
# SIH26091 - FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and set real values for your environment.
# NEVER commit sensitive credentials or real production API keys.
# ==============================================================================

# Core API Configuration (Points to Authoritative FastAPI Backend)
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8080
BACKEND_URL=http://127.0.0.1:8080

# Application Configuration
NEXT_PUBLIC_APP_NAME=Unnate SIH26091
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_THEME=light

# Features & Feature Flags
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_FEATURE_CHAT=true
NEXT_PUBLIC_FEATURE_DPR_PDF=true

# Localization / i18n
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
NEXT_PUBLIC_SUPPORTED_LANGUAGES=en,hi

# Pagination & Session Timeouts
NEXT_PUBLIC_ITEMS_PER_PAGE=10
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=1440

# JWT & Prisma Database URL (Client Session Store)
JWT_SECRET=your-secure-jwt-secret-for-production
DATABASE_URL=file:./dev.db

# Optional Anthropic Claude API Key (Server-Side Next.js Route Handlers)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
