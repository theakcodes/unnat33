generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                  String        @id @default(uuid())
  phone               String        @unique
  name                String
  email               String?
  age                 Int?
  language            String        @default("en") // "en" or "hi"
  state               String        @default("Uttar Pradesh")
  district            String        @default("Lucknow")
  lgdDistrictCode     String?
  isRural             Boolean?
  gender              String?
  socialCategory      String?
  isDifferentlyAbled  Boolean?
  isExServiceman      Boolean?
  isTraditionalArtisan Boolean?
  isStreetVendor      Boolean?
  isStartup           Boolean?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  businesses   Business[]
  advisories   Advisory[]
  chatSessions ChatSession[]
  progressLogs ProgressLog[]
}

model Business {
  id                   String        @id @default(uuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector               String?       // "Manufacturing", "Services", "Trading", "Agriculture"
  type                 String        // Specific trade or business description
  activity             String?
  stage                String?
  description          String?
  isNewBusiness        Boolean?
  estimatedCapital     Float
  targetMonthlyIncome  Float?
  annualIncome         Float?
  annualTurnover       Float?
  monthlyIncome        Float?
  monthlyExpenses      Float?
  existingDebt         Float?
  existingMonthlyEmi   Float?
  projectCost          Float?
  requestedFinancing   Float?
  promoterContribution Float?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  advisories   Advisory[]
  progressLogs ProgressLog[]
}

model Advisory {
  id            String        @id @default(uuid())
  businessId    String
  userId        String
  type          String        // "business_plan", "financial", "schemes"
  planJson      String?       // Stores stringified Claude business plan JSON
  financialJson String?       // Stores stringified loan structures JSON
  status        String        @default("active") // "draft", "active", "archived"
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  schemeMatches SchemeMatch[]
  reports       Report[]
}

model SchemeMatch {
  id                String   @id @default(uuid())
  advisoryId        String
  advisory          Advisory @relation(fields: [advisoryId], references: [id], onDelete: Cascade)
  schemeId          String
  schemeName        String
  eligibilityScore  Float    // 0 to 1
  recommendedAmount Float
  createdAt         DateTime @default(now())
}

model Scheme {
  id           String   @id @default(uuid())
  name         String   @unique
  ministry     String
  description  String
  loanMin      Float
  loanMax      Float
  eligibility  String   // Stringified eligibility criteria JSON
  interestRate Float    // Annual interest rate percentage
  tenure       Int      // Tenure in months
  state        String   @default("all") // "all" or state name
  keywords     String   // Comma-separated keywords
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ChatSession {
  id         String        @id @default(uuid())
  userId     String
  businessId String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String      // "user" or "assistant"
  content   String
  createdAt DateTime    @default(now())
}

model ProgressLog {
  id            String   @id @default(uuid())
  businessId    String
  userId        String
  month         String   // "YYYY-MM"
  actualIncome  Float
  actualExpense Float
  notes         String?
  createdAt     DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id         String   @id @default(uuid())
  businessId String
  userId     String
  advisoryId String?
  pdfUrl     String?
  jsonData   String   // Stringified report JSON
  expiresAt  DateTime // 7 days from creation
  createdAt  DateTime @default(now())

  advisory Advisory?    @relation(fields: [advisoryId], references: [id], onDelete: SetNull)
  shares   SharedLink[]
}

model SharedLink {
  id           String    @id @default(uuid())
  reportId     String
  report       Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  shareToken   String    @unique
  expiresAt    DateTime
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())
}
